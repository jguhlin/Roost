# Carto basemap API key — optional. When set, Map.svelte appends
# ?api_key=… to basemaps.cartocdn.com tile URLs, lifting anonymous rate
# limits. Get one at https://carto.com/basemaps/apikey (a "default public"
# key is fine for client-side use). Unset = keyless public tiles.
VITE_CARTO_API_KEY=

# Movebank API token (Movebank → My Account → API token). Used by the
# detection-ingestion scripts for animal-tracking data. NEVER commit the
# real value — this example file ships empty.
MOVEBANK_TOKEN=

# Dev-only flags (see web/.env.development):
# VITE_LOCAL_LLM=1

# Production analytics (see web/.env.production):
# VITE_MATOMO_URL=https://example.org/matomo/
# VITE_MATOMO_SITE_ID=1
